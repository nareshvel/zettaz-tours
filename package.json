{
  "name": "zettaz-tours",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/apps/api/test/*.test.js",
    "dev": "npm run build && node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/src/main.js",
    "db:migrate": "npm run build && node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/scripts/migrate.js",
    "db:seed": "npm run build && node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/scripts/seed.js",
    "workspace:dev": "npm run build && node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/scripts/workspace.js",
    "demo": "npm run build && node --env-file-if-exists=.env.development --env-file-if-exists=.env dist/apps/api/scripts/demo.js",
    "outbox:drain": "node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/scripts/drain.js",
    "integrations:drain": "npm run build && node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/scripts/drain-integrations.js",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"*.json\"",
    "web:dev": "npm run dev --workspace @zettaz/web",
    "web:build": "npm run build --workspace @zettaz/web",
    "web:typecheck": "npm run typecheck --workspace @zettaz/web",
    "demo:web": "npm run build && START_WEB=1 node --env-file-if-exists=.env.development --env-file-if-exists=.env dist/apps/api/scripts/demo.js",
    "web:smoke": "node apps/web/scripts/smoke.mjs",
    "mobile:start": "npm run start --workspace @zettaz/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @zettaz/mobile",
    "db:migrate:prod": "npm run build && node --env-file=.env.production dist/apps/api/scripts/migrate.js",
    "db:export-demo": "npm run build && node --env-file=.env.development --env-file-if-exists=.env dist/apps/api/scripts/export-demo-tenant.js",
    "stripe:setup": "npx ts-node --project tsconfig.json apps/api/scripts/setup-stripe-plans.ts",
    "stripe:setup:prod": "NODE_ENV=production npx ts-node --project tsconfig.json apps/api/scripts/setup-stripe-plans.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "expo": "~57.0.9",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "^22.6.2",
    "zod": "4.5.4",
    "nodemailer": "^7.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.5",
    "@types/node": "22.20.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "multer": "2.3.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
