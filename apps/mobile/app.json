{
  "expo": {
    "name": "Zettaz Crew",
    "slug": "zettaz-crew",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Zettaz Crew to protect your signed-in session."
        }
      ],
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zettaz Crew to scan passenger check-in codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zettaz.crew"
    },
    "android": {
      "package": "com.zettaz.crew"
    }
  }
}
