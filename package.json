{
  "name": "zettaz-tours",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/apps/api/test/*.test.js",
    "dev": "npm run build && node --env-file=.env dist/apps/api/src/main.js",
    "db:migrate": "npm run build && node --env-file=.env dist/apps/api/scripts/migrate.js",
    "demo": "npm run build && node --env-file-if-exists=.env dist/apps/api/scripts/demo.js",
    "outbox:drain": "node --env-file=.env dist/apps/api/scripts/drain.js",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"*.json\"",
    "web:dev": "npm run dev --workspace @zettaz/web",
    "web:build": "npm run build --workspace @zettaz/web",
    "web:typecheck": "npm run typecheck --workspace @zettaz/web",
    "demo:web": "npm run build && START_WEB=1 node --env-file-if-exists=.env dist/apps/api/scripts/demo.js",
    "web:smoke": "node apps/web/scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.5",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
