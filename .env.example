# The API intentionally refuses production startup in this first slice.
APP_MODE=demo
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-local-development-secret
PORT=3190
# Local tenant workspace. `npm run demo:web` starts it automatically on this port.
WEB_PORT=3191
WEB_ORIGIN=http://127.0.0.1:3191
# Use separate migration-owner and restricted runtime-role credentials.
# npm run demo provisions an isolated local cluster automatically instead.
ADMIN_DATABASE_URL=postgresql://migration_owner:replace-me@127.0.0.1:5432/zettaz_dev
DATABASE_URL=postgresql://zettaz_runtime:replace-me@127.0.0.1:5432/zettaz_dev
DATABASE_ROLE=zettaz_runtime
# Optional for the tenant-scoped outbox:drain CLI; never commit session tokens.
STAFF_SESSION_TOKEN=
