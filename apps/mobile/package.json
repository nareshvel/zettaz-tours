{
  "name": "@zettaz/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "icons": "node ./scripts/generate-icons.mjs",
    "prebuild": "expo prebuild",
    "eas:preview": "eas build --profile preview --platform all",
    "eas:production": "eas build --profile production --platform all",
    "eas:submit": "eas submit --profile production --platform all"
  },
  "dependencies": {
    "expo": "^57.0.9",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3"
  }
}
