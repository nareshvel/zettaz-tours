# ─────────────────────────────────────────────────────────────────────────────
# Zettaz Tours & Charters — environment variable reference
#
# Keep .env.development, .env.production, and this file in the SAME key order
# and groups. Only values (and the title line) differ.
#
# Load order (Node --env-file, later wins):
#   1. .env.development or .env.production
#   2. .env (optional personal overrides)
#   3. Host / PM2 secrets
#
# New laptop:  cp .env.example .env.development
# VPS:         cp .env.example .env.production   then fill live values
# Never commit .env.development, .env.production, or .env
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. App ────────────────────────────────────────────────────────────────────
# APP_MODE: demo | test | production
APP_MODE=demo
PORT=3190
WEB_PORT=3191
API_HOST=0.0.0.0
# Browser origin for CSRF (no trailing slash).
WEB_ORIGIN=http://127.0.0.1:3191
# Links in email (verify, reset, billing, activate). Same host as WEB_ORIGIN.
FRONTEND_URL=http://127.0.0.1:3191
# Staff invite activate links if set; otherwise FRONTEND_URL / WEB_ORIGIN.
APP_PUBLIC_URL=http://127.0.0.1:3191
# Next.js → Nest. Local workspace injects this; set it when running web alone.
API_BASE_URL=http://127.0.0.1:3190

# ── 2. Logging (optional) ─────────────────────────────────────────────────────
# Nest bootstrap route dumps. Uncomment to restore.
# NEST_LOG=verbose
# Next.js incoming request dumps. Uncomment to restore.
# NEXT_REQUEST_LOG=verbose

# ── 3. PostgreSQL ─────────────────────────────────────────────────────────────
# POSTGRES_* is for local compose.yaml only.
# ADMIN_DATABASE_URL = migration owner (DDL).
# DATABASE_URL       = runtime role (DML + RLS).
POSTGRES_USER=zettaz_owner
POSTGRES_PASSWORD=REPLACE
POSTGRES_DB=zettaz_tours
ADMIN_DATABASE_URL=postgresql://zettaz_owner:REPLACE@127.0.0.1:5433/zettaz_tours
DATABASE_ROLE=zettaz_runtime
DATABASE_URL=postgresql://zettaz_runtime:REPLACE@127.0.0.1:5433/zettaz_tours

# ── 4. Security ───────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_BASE64URL

# ── 5. SMTP (verify, reset, invites, booking mail, billing notices) ───────────
# Leave host/user/pass empty to skip send (API logs a manual URL in demo).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zettaz Tours <noreply@zettaz.com>

# ── 6. Document storage ───────────────────────────────────────────────────────
DOCUMENT_HOT_ROOT=.local/document-hot
DOCUMENT_LIBRARY_ROOT=.local/document-library
DOCUMENT_ARCHIVE_ADAPTERS=0
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=

# ── 7. Zettaz SaaS — Stripe Billing (software subscription only) ──────────────
# Dashboard account: Zettaz SaaS. Never use these keys for traveler Checkout.
# Products: npm run stripe:setup  (test)   npm run stripe:setup:prod  (live)
# Webhook:  {WEB_ORIGIN}/webhooks/stripe
# Events:   customer.subscription.created / updated / deleted
#           invoice.paid / invoice.payment_failed
# Local:    stripe listen --forward-to localhost:3190/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# true only on a laptop without Stripe CLI. Must be false in production.
STRIPE_WEBHOOK_SKIP_VERIFICATION=false

# ── 8. Zettaz Pay — Stripe Connect (guest → tenant collections only) ──────────
# Dashboard account: Zettaz Pay. Never equal STRIPE_SECRET_KEY.
# Destinations: see docs/FEATURES/finance/zettaz-pay.md (two destinations, one URL).
# Endpoint: {API}/webhooks/stripe-pay
# Local: stripe listen --forward-to localhost:3190/webhooks/stripe-pay --forward-connect-to localhost:3190/webhooks/stripe-pay
STRIPE_PAY_SECRET_KEY=sk_live_REPLACE
STRIPE_PAY_WEBHOOK_SECRET=whsec_REPLACE
# Platform application fee in basis points. 100 = 1%. Change here to update.
ZETTAZ_PAY_APPLICATION_FEE_BPS=100

# ── 9. Jobs / ops ─────────────────────────────────────────────────────────────
# true = do not send trial/past-due job email. Use true on local demo.
SUBSCRIPTION_JOBS_DISABLED=true
STAFF_SESSION_TOKEN=

# ── 10. Crew Expo (simulator). Store builds use https://tours.zettaz.com/api/mobile
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3190
# EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3191
