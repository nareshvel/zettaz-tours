# ─────────────────────────────────────────────────────────────────────────────
# Zettaz Tours & Charters — environment variable reference
#
# HOW THE ENV FILES WORK
# ─────────────────────────────────────────────────────────────────────────────
# The project uses Node's native --env-file flag (Node ≥ 22).
# Files are loaded in this order (later values win):
#
#   1. .env.development   ← checked in reference values for local dev (gitignored)
#   2. .env               ← personal overrides only (gitignored, optional)
#   3. Platform env vars  ← injected by Render / Railway / Fly / CI (production)
#
# Setup for a new developer:
#   cp .env.example .env.development
#   # then fill in real DB passwords, Stripe test keys, etc.
#
# For production:
#   Copy .env.production as a reference, then set each variable as a secret
#   in your hosting platform's dashboard. Never commit .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# ── App behaviour ─────────────────────────────────────────────────────────────
# development: "demo"   production: "production"
APP_MODE=demo
PORT=3190
WEB_PORT=3191
# Exact browser origin for CSRF checks on mutating /api/* routes (no trailing slash).
# Production must match the public site, e.g. https://tours.example.com
WEB_ORIGIN=http://127.0.0.1:3191
# Public URL used in outbound email links (verify / reset). Usually same host as WEB_ORIGIN.
FRONTEND_URL=http://127.0.0.1:3191
API_HOST=0.0.0.0
# Nest bootstrap route dumps are off by default. Set to "verbose" to restore them.
# NEST_LOG=verbose
# Next.js incoming request dumps (GET /api/…) are off by default. Set to restore them.
# NEXT_REQUEST_LOG=verbose

# ── Outbound email (signup verify, password reset, billing notices) ───────────
# Without these, verification emails are skipped (check API logs for Manual verify URL).
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=REPLACE
# SMTP_PASS=REPLACE
# SMTP_FROM=Zettaz Tours <noreply@zettaz.com>

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Two credentials: migration-owner (DDL) and runtime (DML only, enforces RLS).
ADMIN_DATABASE_URL=postgresql://zettaz_owner:REPLACE@127.0.0.1:5433/zettaz_tours
DATABASE_ROLE=zettaz_runtime
DATABASE_URL=postgresql://zettaz_runtime:REPLACE@127.0.0.1:5433/zettaz_tours

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_BASE64URL

# ── Document storage ──────────────────────────────────────────────────────────
DOCUMENT_HOT_ROOT=.local/document-hot
DOCUMENT_ARCHIVE_ADAPTERS=0
# DOCUMENT_S3_ENDPOINT=
# DOCUMENT_S3_BUCKET=
# DOCUMENT_S3_ACCESS_KEY=
# DOCUMENT_S3_SECRET_KEY=

# ── Stripe Billing (Zettaz SaaS account — acct_1TgFuNDiMTz5HnMK) ─────────────
# Development: use TEST keys (sk_test_...) so no real charges occur.
# Production:  use LIVE keys (sk_live_...) from the Zettaz SaaS account only.
#
# Step 1 — Get keys: https://dashboard.stripe.com → Developers → API keys
# Step 2 — Create products: npm run stripe:setup   (dev test mode)
#                           npm run stripe:setup:prod (prod live mode)
# Step 3 — Register webhook endpoint in Stripe dashboard → Developers → Webhooks
#           Endpoint:  https://your-domain/webhooks/stripe
#           Events to select:
#             customer.subscription.created
#             customer.subscription.updated
#             customer.subscription.deleted
#             invoice.paid
#             invoice.payment_failed
# Step 4 — Copy the signing secret into STRIPE_WEBHOOK_SECRET
#
# For local webhook testing:  stripe listen --forward-to localhost:3190/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ── Optional staff drain token ────────────────────────────────────────────────
STAFF_SESSION_TOKEN=

# Local Expo crew client (simulator). Physical devices need a LAN IP, not loopback.
# Preview/production binaries use https://tours.zettaz.com/api/mobile
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3190
# EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3191
